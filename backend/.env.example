# Copy to backend/.env for local development. Placeholders only — never
# commit real values; production values live in the Render dashboard.
ENV=development
DATABASE_URL=postgresql+asyncpg://bevosita:bevosita@localhost:5432/bevosita
JWT_SECRET=change-me-64-hex
FRONTEND_ORIGINS=http://localhost:5173
# Comma-separated CIDRs of proxies whose X-Forwarded-For may be trusted.
# Empty means trust NO proxy headers (safe default for direct exposure).
TRUSTED_PROXY_CIDRS=
OPENAI_API_KEY=sk-proj-placeholder
OPENAI_MODEL=gpt-4o-mini
ANALYSIS_MAX_COST_USD=0.25
EMAIL_MODE=console
RESEND_API_KEY=re_placeholder
EMAIL_FROM=onboarding@resend.dev
SENTRY_DSN=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKUP_BUCKET_URL=
BACKUP_AGE_PUBLIC_KEY=
