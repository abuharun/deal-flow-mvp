# Copy to backend/.env for local development. Placeholders only — never
# commit real values; production values live in the Render dashboard.
ENV=development
DATABASE_URL=postgresql+asyncpg://bevosita:bevosita@localhost:5432/bevosita
JWT_SECRET=change-me-64-hex
FRONTEND_ORIGINS=http://localhost:5173
# Comma-separated CIDRs of proxies whose X-Forwarded-For may be trusted.
# Empty means trust NO proxy headers (safe default for direct exposure).
TRUSTED_PROXY_CIDRS=
OPENAI_API_KEY=sk-proj-placeholder
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_PROMPT_VERSION=analysis.v1
# The only report schema this codebase currently validates/persists; the
# worker refuses to start if this is set to anything else.
OPENAI_REPORT_SCHEMA_VERSION=report.v1
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=4000
# Per-million-token USD pricing for the configured model; required for the
# worker to start (no report is ever accepted if cost cannot be computed).
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.15
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=0.60
# Conservative flat charge for the one web_search tool enablement per
# attempt; required for the worker to start, included in the cost estimate.
OPENAI_WEB_SEARCH_COST_USD=0.01
ANALYSIS_MAX_COST_USD=0.25
EMAIL_MODE=console
RESEND_API_KEY=re_placeholder
EMAIL_FROM=onboarding@resend.dev
SENTRY_DSN=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKUP_BUCKET_URL=
BACKUP_AGE_PUBLIC_KEY=
